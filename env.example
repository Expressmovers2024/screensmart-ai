# ScreenSmart AI OS — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required for cloud storage and AI proxy authentication.
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Proxy (Supabase Edge Function) ────────────────────────────────────────
# The deployed URL of your ai-proxy Edge Function.
# Format: https://your-project.supabase.co/functions/v1/ai-proxy
EXPO_PUBLIC_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy

# ── Ollama (Local AI — Optional) ─────────────────────────────────────────────
# URL of your local Ollama instance.
# On the same machine: http://localhost:11434
# From a phone on the same Wi-Fi: http://YOUR_COMPUTER_LAN_IP:11434
EXPO_PUBLIC_OLLAMA_URL=http://localhost:11434

# Default Ollama model to use. Run: ollama pull llama3.1:8b
EXPO_PUBLIC_OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ── OpenRouter (Free Cloud AI — Optional) ────────────────────────────────────
# Only needed if you want to call OpenRouter directly from the client
# instead of routing through the Supabase proxy.
# Recommended: leave empty and use the proxy (more secure).
# EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-...

# ── Supabase Edge Function Secrets ───────────────────────────────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets
# DO NOT put these in this file — they go in Supabase, not your app.
#
# OPENROUTER_API_KEY=sk-or-...
# APP_URL=https://your-app-domain.com
# APP_ALLOWED_ORIGINS=https://your-app-domain.com,exp://localhost:8081
